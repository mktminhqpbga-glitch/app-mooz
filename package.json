{
  "name": "workflow-museflow",
  "version": "0.38.1",
  "private": true,
  "description": "Ứng dụng desktop tạo workflow AI với dự án cục bộ và cửa sổ AI tích hợp.",
  "license": "GPL-2.0-or-later",
  "author": "Workflow contributors",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs tests/desktop-*.test.cjs",
    "test:desktop": "node tests/desktop-smoke.cjs && node tests/desktop-layout-smoke.cjs && node tests/desktop-posting-smoke.cjs && node tests/desktop-workspace-smoke.cjs",
    "test:browser": "node tests/browser-smoke.cjs",
    "test:reliability": "node tests/core-reliability-smoke.cjs",
    "package:extension": "python3 tools/package.py",
    "package:desktop": "electron-builder --dir",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "setup:desktop": "install-electron",
    "version:app": "node tools/set-version.cjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "playwright": "1.58.2"
  },
  "build": {
    "appId": "com.museflow.workflow",
    "productName": "Workflow",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "*.html",
      "*.js",
      "*.css",
      "manifest.json",
      "desktop/**",
      "extension/**",
      "icons/**",
      "vendor/**",
      "templates/**",
      "data/**",
      "licenses/**",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json",
      "!desktop/*.test.*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true
    },
    "linux": {
      "category": "Graphics",
      "target": [
        "AppImage",
        "dir"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "artifactName": "Workflow-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "mktminhqpbga-glitch",
        "repo": "app-mooz",
        "releaseType": "draft"
      }
    ],
    "extraResources": [
      {
        "from": "desktop/app-update.yml",
        "to": "app-update.yml"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "ws": "8.22.0"
  }
}
