{
  "manifest_version": 3,
  "name": "Workflow Data Updater",
  "version": "0.1.0",
  "description": "Tải và lưu dữ liệu mới nhất từ GitHub.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.github.com/*", "https://raw.githubusercontent.com/*"],
  "action": { "default_popup": "popup.html" }
}
