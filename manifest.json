{
  "manifest_version": 3,
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https: wss: ws://127.0.0.1:*"
  },
  "name": "Workflow Connect",
  "version": "1.5.0",
  "description": "Kết nối AI và lấy thông tin, ảnh sản phẩm từ tab Shopee đã mở trong Chrome cho MooZ.",
  "action": {
    "default_title": "Kết nối Workflow",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "desktop/connect.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://muse.ai/*",
    "https://*.muse.ai/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://raw.githubusercontent.com/mktminhqpbga-glitch/app-mooz/*",
    "https://www.chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://127.0.0.1/*",
    "https://grok.com/*",
    "https://www.grok.com/*",
    "https://labs.google/fx/tools/flow*",
    "https://labs.google/fx/*/tools/flow*",
    "https://flow.google.com/*",
    "https://shopee.vn/*",
    "https://*.shopee.vn/*",
    "https://shp.ee/*",
    "https://*.shp.ee/*",
    "https://*.susercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://muse.ai/*",
        "https://*.muse.ai/*"
      ],
      "js": [
        "ai-activity.js",
        "composer-controls.js",
        "muse-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://www.chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://grok.com/*",
        "https://www.grok.com/*",
        "https://labs.google/fx/tools/flow*",
        "https://labs.google/fx/*/tools/flow*",
        "https://flow.google.com/*"
      ],
      "js": [
        "ai-activity.js",
        "composer-controls.js",
        "ai-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}
