{
  "manifest_version": 3,
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "name": "Workflow · MuseFlow",
  "version": "0.28.2",
  "description": "Canvas tạo văn bản, ảnh và video với Muse, Gemini, ChatGPT hoặc API.",
  "action": {
    "default_title": "Open MuseFlow",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "unlimitedStorage",
    "downloads"
  ],
  "host_permissions": [
    "https://muse.ai/*",
    "https://*.muse.ai/*",
    "https://raw.githubusercontent.com/bynne2602/museflow/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://queue.fal.run/*",
    "https://raw.githubusercontent.com/mktminhqpbga-glitch/workflow/*",
    "https://api.github.com/*",
    "https://*.fal.media/*",
    "https://fal.media/*",
    "https://www.chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://muse.ai/*",
        "https://*.muse.ai/*"
      ],
      "js": [
        "composer-controls.js",
        "muse-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://www.chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "composer-controls.js",
        "ai-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
